# Stytch public token — find it at https://stytch.com/dashboard?project_id=<your-project-id>
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=

# Crossmint API base URL (server-side). Defaults to production; override only for staging.
CROSSMINT_API_BASE_URL=https://www.crossmint.com/api/unstable

# Crossmint client-side API key — find it at https://www.crossmint.com/console/projects/apiKeys
NEXT_PUBLIC_CROSSMINT_CLIENT_API_KEY=
